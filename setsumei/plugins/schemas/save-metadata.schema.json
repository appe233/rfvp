{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfvp.invalid/plugin/abi-1.0-candidate/save-metadata.schema.json",
  "title": "RFVP save profile metadata (RFPM block, schema 1)",
  "description": "Stored as `metadata JSON | u32_le length | RFPM` immediately before the V1 state payload. At most 65536 bytes. Readers recompute profile_sha256 with the RFVP-PROFILE-1 byte encoding and reject mismatches; duplicate keys are rejected. Plugin and input order are significant. Not a signature.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_sha256", "script_sha256", "nls", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_sha256": {"$ref": "manifest.schema.json#/$defs/sha256"},
    "script_sha256": {"$ref": "manifest.schema.json#/$defs/sha256"},
    "nls": {"enum": ["sjis", "gbk", "utf8"]},
    "plugins": {"type": "array", "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "implementation_sha256", "inputs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_sha256": {"$ref": "manifest.schema.json#/$defs/sha256"},
        "inputs": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string"}, "sha256": {"$ref": "manifest.schema.json#/$defs/sha256"}}}}}}}
  }
}
